{
  "info": {
    "name": "Atividade - Comunicação Síncrona entre APIs",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Testes da API Produtos (8080) e Pedidos (8081). Execute na ordem. Para o teste 10, pare somente Produtos."
  },
  "item": [
    {
      "name": "1 - Produtos / Estoque",
      "item": [
        {
          "name": "01 - Cadastrar produto",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "http://localhost:8080/produtos",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nome\": \"Teclado Gamer\",\n  \"preco\": 150,\n  \"quantidade\": 10\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "02 - Listar produtos",
          "request": {
            "method": "GET",
            "header": [],
            "url": "http://localhost:8080/produtos"
          }
        },
        {
          "name": "03 - Consultar produto ID 1",
          "request": {
            "method": "GET",
            "header": [],
            "url": "http://localhost:8080/produtos/1"
          }
        },
        {
          "name": "04 - Ver estoque ANTES do pedido (10)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "http://localhost:8080/produtos/1/estoque"
          }
        }
      ]
    },
    {
