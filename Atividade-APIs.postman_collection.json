            "url": "http://localhost:8081/pedidos",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"cliente\": \"João\",\n  \"itens\": [\n    {\n      \"produtoId\": 1,\n      \"quantidade\": 3\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "06 - Ver estoque DEPOIS do pedido (7)",
          "request": {
            "method": "GET",
            "header": [],
